{
  "manifest_version": 3,
  "name": "AniPresence",
  "version": "0.4.4",
  "description": "Detect video playback (anime, Crunchyroll, Netflix, YouTube) for the AniPresence desktop companion.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "http://127.0.0.1:32145/*",
    "http://localhost:32145/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "AniPresence", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": { "service_worker": "background.js" }
}
