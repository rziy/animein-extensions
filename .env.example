# Application ID dari https://discord.com/developers/applications (JANGAN isi token Discord).
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
PORT=32145
ENABLE_BROWSER=true

# --- Opsional: app Discord terpisah per situs, biar header jadi "Watching Crunchyroll" / "YouTube" / "Netflix".
# Buat satu application per situs (namanya yang tampil), isi Application ID-nya. Kosong = pakai DISCORD_CLIENT_ID.
# DISCORD_CLIENT_ID_CRUNCHYROLL=
# DISCORD_CLIENT_ID_YOUTUBE=
# DISCORD_CLIENT_ID_NETFLIX=

# --- Tampilan
# Header status: name (nama app) | state | details (judul tontonan jadi header). Kosong = default Discord.
# STATUS_DISPLAY=details
SHOW_TOTAL_EPISODES=true      # "Episode 5/12" kalau total episode ketemu
SHOW_BUTTONS=true             # tombol Watch + View on AniList (cuma kelihatan di profil orang lain)
USE_STATE_ICONS=false         # true = ikon kecil play/pause (upload assets/play.png & pause.png ke Art Assets)
MAX_EP_FOR_S1=60              # tanpa info season & episode <= angka ini, dianggap Season 1

# --- Privasi
HIDE_ADULT=true               # anime dewasa: tampil "Watching something", tanpa judul/cover/tombol, gak masuk riwayat
PAUSE_TIMEOUT_MIN=15          # presence dimatikan kalau di-pause segini lama (0 = nonaktif)
# BLOCKED_HOSTS=example.com,another.site   # situs yang gak pernah dibagikan
